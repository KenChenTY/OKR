OKR_ENV=development
OKR_DATABASE_URL=mssql+pyodbc://localhost/OKR?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&Encrypt=yes&TrustServerCertificate=no
OKR_AUTH_MODE=password
# Local testing only: set auth_mode=development and enable_dev_login=true together.
OKR_ENABLE_DEV_LOGIN=false
OKR_PUBLIC_URL=http://localhost:5173
OKR_TENANT_ID=
OKR_CLIENT_ID=
OKR_CLIENT_SECRET=
OKR_STORAGE_ROOT=../var
OKR_BUSINESS_TIMEZONE=Asia/Shanghai
OKR_HEALTH_GRACE_DAYS=3
OKR_HEALTH_RED_CONFIDENCE=40
OKR_HEALTH_AMBER_CONFIDENCE=70
OKR_HEALTH_RED_LAG=20
OKR_HEALTH_AMBER_LAG=10
OKR_LINK_HOSTS=app.powerbi.com,example.sharepoint.com
OKR_PROJECT_LINK_HOSTS=dev.azure.com,tasks.office.com,planner.cloud.microsoft,example.atlassian.net,example.service-now.com
# Executable called as scanner <path>; exit 0=clean, 1=infected, other=unavailable.
OKR_SCANNER_EXECUTABLE=
